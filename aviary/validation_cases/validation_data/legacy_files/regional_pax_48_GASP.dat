 Smaller Single Aisle / P&W120 @ 2160HP                                             -2                        
 $INGASP
 AS=1.,		! Number of aisles in the cabin
 AR=11.08,	! Wing aspect ratio
 ARHT=4.95,	! Horizontal tail aspect ratio
 ARVT=1.320,	! Vertical tail aspect ratio
 BOELTV=2.2224,	! wing span/vertical tail moment arm (if VBARVX is input)
 COELTH=0.1978,	! wing chord/horizontal tail moment arm (if VBARHX is input)
 DLMC4=0.0,	! sweep of wing quarter chord, degrees
 DWPQCV=36.0,  ! sweep of horizontal tail
 DWPQCH=0.0,	! vertical tail quarter chord sweep in degrees if LCWING <> 0
 ELPC=12.6,	! length of pilot compartment in feet (4.44)
 ELODN=0.715,	! length to diameter ratio of nose cone of fuselage (2)
 ELODT=2.75,	! length to diameter ratio of tail cone of fuselage (3.2)
 HCK=2.75,	! mean fuselage cabin diameter minus mean fuselage nose diameter in feet (2.47)
 HQBWGLT=0.0,   ! winglet height-to-span ratio
 HTG=11.4,	! wing height about ground during ground run in feet (3.0)
 HWING=1.0,     ! wing location on fuselage =0, low wing; =1 high wing
 IGEAR=0,       ! retractable landing gear
 LCWING=0,      ! wing location (=0: do not balance aircraft)
 PAX=48.,	! number of passenger seats excluding crew
 RELR=0.40,     ! fuselage CG location (fraction of fuselage length)
 PS=30.,	! seat pitch in inches
 SAB=4.,	! seats abreast in fuselage
 SAH=1.0, 	! horizontal tail location on vertical tail: 0: low tail, 1: T-tail
 SCFAC=0.0,	! shift in drag divergence Mach number due to supercritical design (0.)
 SF_FAC=1.00,	! Fuselage Wetted Area Adjustment factor (1.); if SF_FAC > 10., input as Fuselage Wetted area (ft^2)
 SLM=.55,	! wing taper ratio
 SLMH=.50,	! taper ratio of horizontal tail
 SLMV=0.514,	! taper ratio of vertical tail
 SLMWGLT=0.,    ! winglet taper ratio
 TCHT=.150,	! horizontal tail root thickness to chord ratio
 TCR=0.18,	! wing root thickness to chord ratio
 TCT=.14, 	! wing tip thickness to chord ratio
 TCVT=.120,	! Vertical tail root thickness to chord ratio
 VBARHX=1.2785,	! Hz tail volume coefficient (default function of fus length and diameter)
 VBARVX=0.1364,	! vertical tail volume coefficient (default function of fuselage length and diameter)
 WAS=24.,	! aisle width, in.
 WS=18.6, 	! seat width, in
 YMG=0.0,  	! span fraction location of main gear on wing    0: on fuselage   1: at tip
 YP=0.333,	! span fraction location of engines on wing    0: on fuselage   1: at tip
 XLQDE=0.4965,	! nacelle scaling factor for turboprop, KNAC=0 or 1
 XWQLF=0.45,	! Distance from Nose to Wing Aerodynamic Center over Fuselage Length (0.40 
 ALPHL0=-1.0,	! zero lift angle of attack in degrees
 CKF=-1.0,	! fuselage drag form factor (numerical function of fuselage fineness ratio)
 CKW=-1.0,	! wing form factor (numerical function of TCR and TCT)
 CKI=1.0,	! Wing/Fuselage Interference Factor (0.0, i.e No interference drag)
 CKN=-1.0,	! nacelle form factor (numerical function of nacelle fineness ratio)
 CKVT=-1.0,	! vertical tail form factor (numerical function of TCVT)
 CKHT=-1.0,	! horizontal tail form factor (numerical function of TCHT and SAH)
 SCFAC=0.0,	! shift in drag divergence Mach number due to supercritical design (0.)
 DELFE=1.00,    ! Delta flat plate area for fuselage (gear pod)
 DELCD=0.0005,	! increment in CD (.0015)
 ! Aero arrays of wing profile drag vs. lift coeef
 KWCD=9,       ! number of ACLS
 ACLS=  0.0,0.40,0.60, 0.80, 1.00, 1.20,  1.40,   1.60, 1.80,
 ACDCDR=1.0, 1.0, 1.0,  1.0, 1.15,1.392,1.7855, 3.5714, 5.360,
  ! Aero Calibration Factoirs
  FEXCRT=1.00,  ! Excrescence drag factor
  FCFWC=1.00,   ! Wing
  FCFFC=1.00,   ! Fuselage
  FCFVTC=1.00,  ! Vertical tail
  FCFHTC=1.00,  ! Horizontal tail
  FCFNC=1.00,    ! Nacelle/Pylon
  FPYLND=1.00,   ! Pylon drag factyor
  FCKIC=1.00,   ! Interference
  FSA7C=1.00,   ! Induced
  FCMPC=1.00,     ! Compressibility
  XCPS=0.25,     ! peak suction location
  XCTCMX=0.30,   ! max thickness location
  ! Aero Technology Factors
  FCFWT=1.00,   ! Wing
  FCFFT=1.00,    ! Fuselage
  FCFVTT=1.00,  ! Vertical tail
  FCFHTT=1.00,  ! Horizontal tail
  FCFNT=1.00,  ! Nacelle/Pylon
  FEXCRT=1.00,  ! Excrescence
  FCKIT=1.00,   ! Interference
 ! End Aero
 EYEW=2.0,	! wing incidence to fuselage horizontal reference in degrees
 ! KNAC determines nacelle drag bookkeeping
 ! 0: nacelle drag computed as penalty to engine performance (turbofans only)
 ! 1: nacelle drag part of aircraft drag; nacelle sized by engine size
 ! 2: same as 1, except uses nacelle size inputs DRARN, ELN    
 KNAC=1, 
 ! BENGOB=0.05,	! fraction of flap-free wing span due to engines
 BTEOB=0.660, 	! ratio of flap span to wing span
 CFOC=0.225, 	! flap chord to wing chord ratio
 ! CLEOC=0.0,	! ratio of leading edge device chord to wing chord (0 for no LED)
 ! DCDOTE=0.10, 	! drag coeff increment due to optimally deflected TE flaps
 ! DCLMLE=0.0 ,   ! Ref. Delta CL L.E.
 ! DELLEO= 0., 	! optimal deflection for leading edge device degrees (45)
 ! DELTEO=20.,    ! Opt.T.E.DEFL(deg)
  DFLPTO=10.,	! takeoff flap deflection, degrees
 ! DELLED=0.,	! leading edge device deflection, degrees (0) when?
 ! DCLMTE=0.0,	! lift coefficient increment due to optimally deflected TE flaps
 DFLPLD=40., 	! landing flap deflection, degrees
 FLAPN=2., 	! number of flap segments per wing panel (1)
 ! JFLTYP 1:plain flap, 2:split flap, 3:single slotted flap (default), 4:double slotted flap
 !        5:triple slotted flap, 6:Fowler flap, 7:double slotted Fowler flap
 JFLTYP=3,
 ! RCLMAX is the CLMAX reference value of basic wing reference conditions: aspect ratio = 12, taper ratio = 1., 
 !              t/c = 0.10, SweepQC = 0, Re = 6 x 10^6
 RCLMAX=1.50,
 WCFLAP=-1.0, 	! weight trend coefficient in flap weight equation (default is a function of JFLYTYP)
 ! CATD structural design category
 ! 0 normal design FAR Part 23
 ! 1 utility design FAR 23
 ! 2 aerobatic design FAR 23
 ! 3.0 for transports FAR Part 25
 ! >3 value of input design limit load factor
 CATD=3.,       ! design structural category (=3: FAR Part 25 transport)
 VMLFSL=345.0, 	! maximum structural design flight speed, mph
 DELP=6.55,	! fuselage pressure differential, psi
 DELWST=0.,     ! incremental structural weight, lb. (0.)
 GRFE=0.,       ! landing gear flat plate area (=0: defalut to function of WGTO)
 FPYL=0.0,	! factor for turbofan engine pylon weight if NTYE=7 and KNAC=2
 SKB=133.5,	! weight trend coefficient of fuselage
 SKCC=20.0,	! weight trend coefficient of cockpit controls
 SKWF=.48,	! fraction of total theoretical wing volume used for wing fuel
 SKFS=.0415,	! weight trend coefficient for fuel system
 SKFW=.60,	! weight trend coefficient of fixed wing controls
 SKPEI=.2489,	! weight trend coefficient of engine installation, fraction dry engine
 SKLG=.0400,	! weight trend coefficient of landing gear, fraction gross weight
 SKMG=.816, 	! weight trend coefficient main gear, fraction of landing gear
 SKPES=0.25,	! weight trend coefficient of engine nacelle, fraction dry engine, if KNAC <> 2
 SKSTRUT=0.,    ! weight trend coefficient of strut, strut weight/wing weight
 SKWW=115.0, 	! weight trend coefficient of wing without high lift devices
 SKY=.09358,	! weight trend coefficient horizontal tail
 SKZ=.1396, 	! weight trend coefficient vertical tail
 UWNAC=2.5, 	! nacelle weight/nacelle surface area; lb per sq ft, if KNAC <> 2
 UWPAX=209.44,	! weight per passenger, including baggage, lb (200.)
 UWTWGLT=0.,    ! winglet areal weight (lb/sqft)
 WCARGO=1631.,	! weight of cargo, lb
 WG=41005., 	! initial gross weight guess, lb
 WGS=69.855, 	! wing loading, psf
 FVOL_MRG=82.5,  ! fuel volume margin
 ISWING=0,      ! =0: fix WGS; =1: fix wing area
 WPLX=0.,	! design payload, lb (default function of PAX)
 ! CW are weight coefficients for various subsytems.  >1 is actual weight in lbsf 
 CW(1)=100.,   	! APU
 CW(2)=.0416,  	! instruments
 CW(3)=0.302,   ! hydraulics for flight controls
 CW(4)=.140,    ! hydraulics for gear
 CW(5)=465.,  	! avionics
 CW(6)=1.65,   	! air conditioning
 CW(7)=175.,   	! anti-icing system
 CW(8)=-66.1,   ! furnishings (Furnishing weight per passenger)(0.)
 CW(9)=2.0,    	! passenger service items lbsf per passenger
 CW(10)=1.5,   	! water lbsf per occupant
 CW(11)=25.0,   ! emergency equipment
 CW(12)=4.4,   	! catering items lbsf per passenger CW(13)=6.0,
 CW(13)=4.5,     ! trapped fuel factor
 CW(14)=1.001,  ! cargo handling, number of ULD's per passemger
 CW(15)=10.0,   ! electrical system weight per passenger (16.0)
 CW(16)= 0.,    ! other operating items (0)
 CKFF=1.010,    ! factor on installed engine fuel flow
 DCDSE=0.0,	! delta CD due to engine out (default is zero), -1: program computes increment
 DNQDE=1.20,	! Nacelle Diamter-to-Engine Diameter Ratio
 ENP=2.		! number of engines
 ! NTYE sets the type of engine
 ! 1: reciprocating engine with carburetor, 2: reciprocating engine with fuel injection
 ! 3: recip engine with fuel injection and geared, 4: rotary combustion engine
 ! 5: turboshaft engine, 6: turboprop engine
 ! 7: turbojet or turbofan engine
 ! 11, 12, 13 same as 1, 2, 3 except HOPWSZ computes geometry and weight
 ! 14 same as 4 except RCWSZ computes geometry and weight
 NTYE=6,        ! Turboprop engine
 RELP=0.0,	! engine cg fraction of fuselage length, for fuselage mounted engines, (0.) if LCWING <> 0
 SWSLS=.5089, 	! engine specific weight lb/lb thrust or lb/HP for recip/ turboprop if KNAC <> 2
 THIN=0., 	! input thrust for one engine, lbf., if JENGSZ=4 and NTYE=7 
 EMCRU=0.4955,	! design cruise Mach number for engine sizing (not mission analysis)
 HNCRU=25000.,	! design cruise altitude in feet
 HSCREQ=10000.,	! required engine-out service ceiling
 ! IWLD         0: landing weight = gross weight (default)  1: landing weight = weight at end of mission
 !              2: landing weight = fraction of gross weight (see WLPCT)
 IWLD=2,
 ! JENGSZ sets the type of engine sizing
 ! 0: size engine for cruise only
 ! 1: cruise and takeoff only
 ! 2: cruise, takeoff, and climb only
 ! 3: size for cruise and climb only
 ! 4: engine thrust specified; (input KNAC=2, ELN, DBARN, WENG, WNAC) only if NTYE=7
 JENGSZ=0,
 IPART=1,       ! FAR Part 25 climb requirements
 RWCRTX=.985,	! ratio of cruise weight to gross weight for propulsion sizing (1.0)
 WLPCT=0.976,   ! ratio of landing weight to gross weight, if IWLD=2
 RCCRU=100.,     ! required rate-of-climb at cruise, fpm
 ROCTOC=650.,	! rate of climb at top of climb ft/min
 XTORQ=4000.,	! required takeoff distance to clear 35 ft, input if JENGSZ=1 or 2 (99999.)
 ARNGE(1) = 0., ! 0: no range or endurance requirement (default) <24: design endurance, hrs >24: design range, nm
 ! ARNGE(2) = 0.,  ! Design Altitude, Short Range
 ARNGE(3) =   0.,    ! Off Design Altitude, Short Range
 ! ARNGE(4) = 0.,  ! Off Design Altitude, Long Range
 CRALT =25000.,	! mission cruise altitude, ft (HNCRU)
 CRMACH=.4955,	! mission analysis cruise Mach number (use EMCRU for engine sizing)
 DELTT=0.167,	! time spent taxiing before takeoff and after landing, hours
 DV1=5.,	! increment of engine failure decision speed above stall, kts (5)
 TDELLD=0.,    ! temperature increment above STD for landing   
 TDELTX=0.,    ! temperature increment above STD for takeoff
 TDELTO=27.,     ! temperature increment above STD for takeoff engine sizing
 DVR=5.,	! increment of takeoff rotation speed above engine failure decision speed above stall, kts (5)
 XLFMAX=1.20,   ! Max T.O. Normal Load Factor
 HTMAX=250.,   ! takeoff termination altitude (500)
 ! ICLM  1: climb at maximum rate of climb (default)  2: climb at maximum allowable operating speed
 !       3: climb at input EAS
 ICLM=1,
! ICRUS = 0, cruise at CRALT (default) for cost and range calculation
! ICRUS = 1, cruise at normal power for cost and range calculation
! ICRUS = 2, cruise for best specific range for cost and range calculation
! ICRUS = 3, cruise for best endurance for cost and range calculation
! ICRUS = 10,11,12,13  Cruise/Climb at constant Mach Number
! ICRUS = 20,21,22,23  Cruise/Climb at constant True Airspeed, TAS
! ICRUS = 30,31,32,33  Cruise/Climb at constant Equivalent Airspeed, EAS
 ICRUS=0,	! Cruise specifier
 IFERRY=0,      ! Ferry Mission Flag
 MX=0,		! 0  No alternate mission profile (default); 1 – Alternate mission profile input in NEWMIS namelist
 NFAIL=0,	! 0: computes engine out and accelerate/stop distance, 1: computes only all engine performance (default)
 OFALT=0., 	! off design mission altitude in feet (0.0)
 OFEM=.40,	! off design specified mission Mach number
 ROSCAB=900.,	! cabin rate of sink during descent (500.) fpm
 RSMX=900.,	! maximum allowable rate of sink during landing approach ft per min (1000)
 FRESF=0.222,   ! Reserve Fuel fraction of mission fuel (minus sign for code trigger)
 FRESF=1.0,  !
 RF(1)=2.0,	! Reserve Fuel Input: Time for Missed Approach (min)
 RF(2)=125.,	! Reserve Fuel Input: Range to alternate
 RF(3)=15000.,	! Reserve Fuel Input: Cruise altitude to alternate 
 RF(4)=1500., 	! Reserve Fuel Input: Holding Altitude
 RF(5)=4.0,     ! Approach/Landing time, min (0.)
 RF(6)=5.0,     ! Percent mission fuel reserce, % (0.0)
 RF(7)=0,       ! Alternate cruise Mach flag (=0: EMCRU ; =1: EMBSR) (1)
 RF(8)=0,       ! Hold Mach flag (=0: EMBEN ; =1: 1.4*VKST_APP) (0)
 SINKTD=5.,	! landing touchdown sink rate, ft per sec (3.0)
 TDELAY= 2.0,   ! brake application delay time, secs
 TIDLE=200.,    ! idle thrust
 VCLMB=250.,	! climb speed, EAS, kts (input only if ICLM=3)
 VRATT=1.30,    ! Aprroach speed-t0-stall speed
 XLFMX=1.15, 	! landing flare load factor if < 4 or landing flare initiation height, ft if > 4.  (1.2)
 ! Economic Inputs (Inpit TBO = 0 to skip
 ALR=1.11, 	! man-hour labor rate $ per hour ?
 CINP=.11, 	! cost of annual inspection ?
 CLIAB=2021.,	! cost of liability insurance ?
 CMF=15.,	! increment to fixed annual cost ?
 CMV=.15,	! increment to hourly operating cost ?
 CRWOH=15.,     ! crew overhead rate ? 
 DYR=12.,      	! aircraft depreciation period in years (8)
 FCSF=4.66,     ! fuel cost, $ per gallon (0.51)      
 HIR=0.015,     ! hull insurance rate; insurance cost/aircraft price (0.02)
 HRI=5000000.,     ! hours between annual inspection (100)
 OHR=350.,  	! Overhaul cost of one engine, $ per lb thrust or $ per HP (5.5)
 PRV=.15,  	! aircraft residual value/original value (0.2)
 RI=.8,     	! loan interest rate; yearly interest/loan (0.)
 SRPM=18000.,   ! Cabin Attendant Cost ($/yr.)   
 TBO=0., 	! time between overhauls, hr (0. default which deletes cost computations)
 TR=1.0,  	! property tax rate; tax/value (0.)
 $END
 $INPROP 
 AF=115.,       ! proeplller/Q-FAN balse activity factor
 ANCQHP=.0455,   ! nacelle area per horsepower (.12) 
 BL=6.,         ! number of blades
 BLANG=0.,      ! balde 3/4 pitch (fixed prop only)
 CLI=.50,       ! propeller integrated design lift coeff
 CTI=0.2,       ! initial estimate of propeller thrust coefficient (.2)
 DIST=1000.,    ! slant distance to observer for propeller noise, ft (1000.)
 DPROP=12.92,    ! propeller diameter, ft
 FT=-1.0,       ! fraction of total prop thrust lost due to installation (0.),=-1: claculated
 GR=.058666667, ! gear ratio, propeller rpm/engine rpm (1.)
 HNOYS=1000.,   ! aircraft altitude for noise calculation, ft (1000.) if KNOYS = 0 or 1
 HPMSLS=2160.,  ! maximum sea level static horsepower (0.) if KODECR=7
 IDATE=1980,    ! propeller weight technology level; 1970 or 1980, if NTYP > 10
 ! JSIZE: 1, increase HP with constant propeller diameter
 !        2, increase both HP and diameter, keep disk loading constant (default)
 JSIZE=1,
 KNOYS=-1,      ! noise calculation flag (=-1: no noise calcs)
 KODECR=7,      ! =3, 4, size engine at specified flight condition 
 KODETH=6,      ! =5 or 6, find engine operating point (per cent max power) at specified flight condition
 NTYP=15,       ! propeller type: 5, constant speed, full feathering, deicing propeller with reverse
 PCLER=0.1724   ! propeller tip - fuselage clearance, fraction of propeller diameter
 PCNCCL=1.00,   ! percent corrected rotor speed at climb for turboprop
 PCNCCR=0.9150,   ! percent corrected rotor speed at cruise for turboprop
 PCNCTO=1.00,   ! percent corrected rotor speed at cruise for turboprop
 TSPDMX=825.,   ! maximum allowable propeller tip speed, ft per sec
 WKPFAC=.79,    ! propeller weight adjustment factor (1.0)
 WPROP1=268.,   ! weight of one propeller, lb., if KNAC = 2
 XNMAX=20000.,  ! maximum engine speed, rpm
 $END
 